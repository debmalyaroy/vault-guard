# ── VaultGuard Environment Configuration ─────────────────────────────────────
# Copy this file to .env and fill in the values.
# Leave AWS credentials empty to run in offline mock mode (USE_MOCK_BEDROCK=true).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# ── Storage ───────────────────────────────────────────────────────────────────
# Absolute path for BoltDB. In Docker, mount a volume at this path.
DATA_DIR=./data

# ── Mock Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to run without AWS credentials (fully offline, deterministic responses).
# Seed corpus and all pipeline stages work with the built-in mock Bedrock client.
USE_MOCK_BEDROCK=true

# ── AWS Credentials (leave empty in mock mode) ────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: IAM role via EC2/ECS instance metadata (no key needed in AWS)
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/VaultGuardBedrockRole

# ── Bedrock Model Selection ───────────────────────────────────────────────────
# Stage 3 — Injection Classifier (fast, cheap)
BEDROCK_CLASSIFIER_MODEL=amazon.nova-lite-v1:0

# Stage 5 — Goal Drift Detector (reasoning model)
BEDROCK_REASONING_MODEL=meta.llama3-3-70b-instruct-v1:0

# Policy compiler + attack variant generator
BEDROCK_POLICY_MODEL=amazon.nova-pro-v1:0

# Corpus embeddings
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# ── Alternative Bedrock Models ────────────────────────────────────────────────
# BEDROCK_CLASSIFIER_MODEL=amazon.nova-micro-v1:0        # Cheapest option
# BEDROCK_CLASSIFIER_MODEL=mistral.mistral-7b-instruct-v0:2  # Budget fallback
# BEDROCK_REASONING_MODEL=mistral.mistral-large-2402-v1:0    # Alternative reasoner
# BEDROCK_POLICY_MODEL=cohere.command-r-plus-v1:0            # RAG-augmented

# ── Frontend (Vite dev server / Docker build args) ────────────────────────────
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
